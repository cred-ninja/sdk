{
  "host": "127.0.0.1",
  "port": 3456,
  "publicUrl": "http://127.0.0.1:3456",
  "trustDomains": {
    "domain-b.example": { "witBundle": "./domain-b.example.wit-bundle.json", "keyUse": "wit-svid" }
  },
  "txnTokens": {
    "domain-b.example": {
      "aud": "domain-b.example",
      "jwks": "./domain-b.example.txn-jwks.json",
      "keyUse": "sig",
      "userSubject": { "claim": "sub", "pattern": "^user:([a-z0-9._-]{1,64})$" },
      "scopeMap": { "google": { "calendar.read": ["calendar.readonly"], "calendar.write": ["calendar.events"] } },
      "required": true
    }
  },
  "httpSignature": { "audiences": [] },
  "user": "alice",
  "connectionScopes": ["calendar.readonly", "calendar.events"],
  "agents": [
    { "name": "planner", "workload": "spiffe://domain-b.example/ns/agents/sa/planner", "allowedScopes": ["calendar.readonly"] }
  ]
}
