{
  "name": "@credninja/ai",
  "version": "2.0.0",
  "description": "Cred Vercel AI SDK integration — credential delegation tool for Vercel AI agents",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/cjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ../../../scripts/write-package-types.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cred",
    "vercel",
    "ai-sdk",
    "oauth",
    "delegation",
    "ai-agents"
  ],
  "author": "Cred",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@credninja/sdk": "^2.0.0",
    "ai": ">=5.0.52",
    "zod": ">=3.0.0"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15"
  },
  "devDependencies": {
    "@credninja/sdk": "^2.0.0",
    "@types/node": "^20.10.6",
    "ai": "^7.0.77",
    "typescript": "^5.3.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cred-ninja/sdk.git",
    "directory": "packages/integrations/vercel-ai"
  },
  "homepage": "https://cred.ninja",
  "bugs": {
    "url": "https://github.com/cred-ninja/sdk/issues"
  }
}
