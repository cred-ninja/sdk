{
  "name": "@credninja/mcp",
  "version": "2.0.0",
  "description": "MCP server for OAuth2 credential delegation. Secure token brokering for AI agents",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cred-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\" && npx tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "cred",
    "mcp",
    "oauth",
    "delegation",
    "ai-agents",
    "credentials"
  ],
  "author": "Cred",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@credninja/sdk": "^2.0.0",
    "@credninja/guard": "^2.0.0"
  },
  "peerDependencies": {
    "@credninja/oauth": "^2.0.0",
    "@credninja/vault": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@credninja/oauth": {
      "optional": true
    },
    "@credninja/vault": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cred-ninja/sdk.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://cred.ninja",
  "bugs": {
    "url": "https://github.com/cred-ninja/sdk/issues"
  }
}
