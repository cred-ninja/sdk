{
  "name": "@credninja/link",
  "version": "2.0.0",
  "description": "Cred Link: drop-in account-connection widget for Cred (vanilla JS)",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npx tsc -p tsconfig.cjs.json && npx tsc -p tsconfig.esm.json && node ../../scripts/write-package-types.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cred",
    "oauth",
    "delegation",
    "ai-agents",
    "widget"
  ],
  "author": "Cred",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@credninja/protocol": "^2.0.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cred-ninja/sdk.git",
    "directory": "packages/link"
  },
  "homepage": "https://cred.ninja",
  "bugs": {
    "url": "https://github.com/cred-ninja/sdk/issues"
  }
}
