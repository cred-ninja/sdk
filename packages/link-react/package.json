{
  "name": "@credninja/link-react",
  "version": "2.0.0",
  "description": "Cred Link: React bindings for the Cred account-connection widget",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npx tsc -p tsconfig.cjs.json && npx tsc -p tsconfig.esm.json && node ../../scripts/write-package-types.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cred",
    "oauth",
    "delegation",
    "ai-agents",
    "widget",
    "react"
  ],
  "author": "Cred",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cred-ninja/sdk.git",
    "directory": "packages/link-react"
  },
  "homepage": "https://cred.ninja",
  "bugs": {
    "url": "https://github.com/cred-ninja/sdk/issues"
  },
  "dependencies": {
    "@credninja/link": "^2.0.0"
  }
}
