{
  "name": "@credninja/server",
  "version": "2.2.0",
  "description": "Self-hosted credential delegation server for AI agents. Uses @credninja/oauth + @credninja/vault",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cred-server": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "files": [
    "dist",
    ".env.example",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "cred",
    "oauth",
    "delegation",
    "ai-agents",
    "credentials",
    "server",
    "self-hosted"
  ],
  "author": "Cred",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@credninja/attenuation": "^2.2.0",
    "@credninja/guard": "^2.2.0",
    "@credninja/oauth": "^2.2.0",
    "@credninja/protocol": "^2.2.0",
    "@credninja/tofu": "^2.2.0",
    "@credninja/vault": "^2.2.0",
    "@types/express": "^5.0.5",
    "better-sqlite3": "^13.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^5.1.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "jsdom": "^31.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cred-ninja/sdk.git",
    "directory": "packages/server"
  },
  "homepage": "https://cred.ninja",
  "bugs": {
    "url": "https://github.com/cred-ninja/sdk/issues"
  }
}
